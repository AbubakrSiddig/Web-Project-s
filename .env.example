# =============================================================================
# إعدادات بيئة العمل — نظام بوكر فارما لإدارة وتوزيع الأدوية
# =============================================================================

APP_NAME="نظام إدارة أعمال بوكر فارما"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# قواعد بيانات MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poker_pharma
DB_USERNAME=poker_user
DB_PASSWORD=your_strong_password

# نطاقات CORS المصرح لها بالاتصال (مفصولة بفواصل، أو فارغة للمطابقة التلقائية)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# جلسات العمل
SESSION_LIFETIME=86400
